# 前端资源打包的 CMake 回退实现（无 Python 环境时使用）。
#
# 生成：
#   <GEN_DIR>/resource_ids.h   资源 ID → 路径宏
#   <GEN_DIR>/resources.rc     rc.exe 资源脚本
#   <GEN_DIR>/resource_map.cpp VirtualFS::LoadFromResources 实现
#
# 用法：
#   cmake -DFRONTEND_DIR=... -DGEN_DIR=... [-DRESOURCE_TYPE=TAURI_RES]
#         -P tools/pack_resources_cmake.cmake

if(NOT DEFINED FRONTEND_DIR OR NOT DEFINED GEN_DIR)
    message(FATAL_ERROR "pack_resources_cmake.cmake: 需要 FRONTEND_DIR 与 GEN_DIR")
endif()
cmake_minimum_required(VERSION 3.21)
if(NOT DEFINED RESOURCE_TYPE OR RESOURCE_TYPE STREQUAL "")
    set(RESOURCE_TYPE "TAURI_RES")
endif()

get_filename_component(FRONTEND_DIR "${FRONTEND_DIR}" ABSOLUTE)
get_filename_component(GEN_DIR "${GEN_DIR}" ABSOLUTE)
file(MAKE_DIRECTORY "${GEN_DIR}")

file(GLOB_RECURSE entries RELATIVE "${FRONTEND_DIR}" "${FRONTEND_DIR}/*")
list(SORT entries)

set(ids_text "// Auto-generated by pack_resources_cmake.cmake\n")
string(APPEND ids_text "// Maps numeric resource IDs to virtual paths\n\n")
string(APPEND ids_text "#pragma once\n\n")

set(rc_text "// Auto-generated by pack_resources_cmake.cmake\n")
string(APPEND rc_text "#include \"resource_ids.h\"\n\n")

set(map_text "// Auto-generated by pack_resources_cmake.cmake\n")
string(APPEND map_text "#include \"tauricpp/virtual_fs.hpp\"\n")
string(APPEND map_text "#include \"resource_ids.h\"\n")
string(APPEND map_text "#include <Windows.h>\n\n")
string(APPEND map_text "namespace tauricpp {\n\n")
string(APPEND map_text "void VirtualFS::LoadFromResources(HMODULE hModule) {\n")

set(index 0)
foreach(rel IN LISTS entries)
    set(abs "${FRONTEND_DIR}/${rel}")
    if(IS_DIRECTORY "${abs}")
        continue()
    endif()

    # 统一使用正斜杠，rc.exe 与 C++ 字符串都能直接使用。
    string(REPLACE "\\" "/" rel_path "${rel}")
    string(REPLACE "\\" "/" abs_path "${abs}")
    string(REPLACE "\"" "\\\"" abs_path "${abs_path}")

    # 资源宏：非字母数字全部替换为下划线，并追加序号避免重名。
    string(REGEX REPLACE "[^A-Za-z0-9]" "_" safe_name "${rel_path}")
    string(TOUPPER "${safe_name}" safe_name)
    math(EXPR res_id "${index} + 1000")
    set(res_macro "RES_${safe_name}_${index}")

    string(APPEND ids_text "#define ${res_macro} ${res_id}\n")
    string(APPEND rc_text "${res_macro} ${RESOURCE_TYPE} \"${abs_path}\"\n")

    string(APPEND map_text "    {\n")
    string(APPEND map_text
        "        HRSRC hrsrc = FindResourceW(hModule, MAKEINTRESOURCEW(${res_macro}), L\"${RESOURCE_TYPE}\");\n")
    string(APPEND map_text "        if (hrsrc) {\n")
    string(APPEND map_text "            HGLOBAL hGlobal = LoadResource(hModule, hrsrc);\n")
    string(APPEND map_text "            if (hGlobal) {\n")
    string(APPEND map_text "                DWORD size = SizeofResource(hModule, hrsrc);\n")
    string(APPEND map_text "                void* data = LockResource(hGlobal);\n")
    string(APPEND map_text "                if (data && size > 0) {\n")
    string(APPEND map_text
        "                    std::vector<uint8_t> fileData(static_cast<const uint8_t*>(data), static_cast<const uint8_t*>(data) + size);\n")
    string(APPEND map_text "                    RegisterFile(\"/${rel_path}\", fileData, \"\");\n")
    string(APPEND map_text "                }\n")
    string(APPEND map_text "            }\n")
    string(APPEND map_text "        }\n")
    string(APPEND map_text "    }\n")

    math(EXPR index "${index} + 1")
endforeach()

string(APPEND ids_text "\n#define RES_COUNT ${index}\n")
string(APPEND map_text "}\n\n}  // namespace tauricpp\n")

file(WRITE "${GEN_DIR}/resource_ids.h" "${ids_text}")
file(WRITE "${GEN_DIR}/resources.rc" "${rc_text}")
file(WRITE "${GEN_DIR}/resource_map.cpp" "${map_text}")

message(STATUS "已打包 ${index} 个前端资源到 ${GEN_DIR}")
